    {
      "id": "ZWD-E-10",
      "art": "ziwei",
      "theme": "禄马同宫",
      "school": "紫微斗数全书·当前三卷电子本",
      "paragraph_ids": [
        "ziwei-doushu-quanshu:L0976-L0987",
