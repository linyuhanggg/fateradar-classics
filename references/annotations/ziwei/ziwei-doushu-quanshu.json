    {
      "paragraphId": "ziwei-doushu-quanshu:L0172-L0172",
      "kind": "理论",
      "vernacular": "本赋分别提出男命看生旺得地、女命在死绝条件下特别看福德的旧式读法。",
      "terms": [
        "男女命旧法",
        "生旺死绝",
        "福德宫"
      ],
      "notes": [
        "这是古代性别分工视角，不据性别降低女性价值或将某一旺衰规则推广全盘。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "ziwei-doushu-quanshu:L0174-L0174",
      "kind": "规则候选",
      "vernacular": "命宫忌落败位，财务相关星位忌空亡；作者把人生基础和财源分为两个关注点。",
      "terms": [
        "命败位",
        "财空亡"
      ],
      "notes": [
        "败位及财源所指需具体化，不只是命宫或财帛宫里某个关键词。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "ziwei-doushu-quanshu:L0176-L0176",
      "kind": "规则候选",
      "vernacular": "嗣续即子女宫。机、刑、杀、荫、孤等星类在这里还加恶星、化忌、耗曜，本书作不利评价。",
      "terms": [
        "嗣续子女宫",
        "孤星",
        "忌耗"
      ],
      "notes": [
        "要保留子女宫及‘加’的叠加条件；本句别称未逐一展开，不以此断生育能力或子女命运。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "ziwei-doushu-quanshu:L0178-L0178",
      "kind": "规则候选",
      "vernacular": "陀罗、耗曜、囚星守父母宫，是作者讨论家业和亲属受损的一组条件。",
      "terms": [
        "陀耗囚",
        "父母宫"
      ],
      "notes": [
        "囚等别称须辨认，守宫不能改成任意会照；不据此认定父母实际遭灾。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "ziwei-doushu-quanshu:L0180-L0180",
      "kind": "理论",
      "vernacular": "儿童命式还要结合相貌、成长根基等条件细看，本赋没有让单个星曜代替全部判断。",
      "terms": [
        "童格",
        "根基"
      ],
      "notes": [
        "本句没有提供可以据盘核准出生时辰或健康的独立方法。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "ziwei-doushu-quanshu:L0182-L0182",
      "kind": "理论",
      "vernacular": "再次列星曜形象：紫微偏丰润，天府偏有精神，禄存作为禄主也取厚重。",
      "terms": [
        "紫微天府禄存",
        "厚重"
      ],
      "notes": [
        "与前段形性说相互参照，不作为身体测量事实。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "ziwei-doushu-quanshu:L0184-L0184",
      "kind": "理论",
      "vernacular": "日月、文曲、天相、天同、天梁、天机、文昌被合列为清秀俊美之象，并配上长下短、眉眼清秀等描述。",
      "terms": [
        "清奇形性",
        "日月昌曲"
      ],
      "notes": [
        "这是一组星曜的类象归纳，不表示这些星必须同宫才成一个美貌格。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "ziwei-doushu-quanshu:L0186-L0186",
      "kind": "规则候选",
      "vernacular": "贪狼与武曲相同处时，作者描述形小声高、气量大；天同遇陀罗化忌的另一分支，则描述丰润而眼目不利。",
      "terms": [
        "武贪",
        "天同陀忌"
      ],
      "notes": [
        "两个不同组合须分别核位置关系；眼目情况不能据星曜诊断。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "ziwei-doushu-quanshu:L0188-L0188",
      "kind": "规则候选",
      "vernacular": "擎羊再遇火铃、巨暗或耗杀，本书以损伤、痣和粗貌等描写叠加后的形性。",
      "terms": [
        "擎羊加煞",
        "火铃巨暗",
        "形貌"
      ],
      "notes": [
        "不同加会条件不要压成擎羊单星；不把伤痣当实际身体检查结果。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "ziwei-doushu-quanshu:L0190-L0190",
      "kind": "规则候选",
      "vernacular": "幼童或老人行到死绝之限时，作者以养育难效、寿终等强烈话语强调不利。",
      "terms": [
        "死绝之限",
        "童老"
      ],
      "notes": [
        "原文没有可用的死亡概率或寿数模型，不能据此断童老生死。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "ziwei-doushu-quanshu:L0192-L0192",
      "kind": "评注或元数据",
      "vernacular": "形性赋把前述内容称作数理纲领，劝读者专心体会并相互参照。",
      "terms": [
        "纲领",
        "参究"
      ],
      "notes": [
        "赞语不等于这些外貌性格断法已经验证。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "ziwei-doushu-quanshu:L0194-L0194",
      "kind": "理论",
      "vernacular": "运限有高低起伏，星曜也有适宜或不适宜的条件；配置驳杂时，人生表现更可能有浮沉。",
      "terms": [
        "运限",
        "星曜喜忌",
        "驳杂"
      ],
      "notes": [
        "本句不给固定分值，不应转成一张自动吉凶评分表。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "ziwei-doushu-quanshu:L0196-L0196",
      "kind": "理论",
      "vernacular": "遇到煞地或空亡，要加倍查清具体条件。作者以精研为结尾，强调不能草率断占。",
      "terms": [
        "煞地",
        "空亡",
        "细察"
      ],
      "notes": [],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "ziwei-doushu-quanshu:L0199-L0199",
      "kind": "重复",
      "vernacular": "星垣论后的网页编辑标记，是同类抓取残留。",
      "terms": [
        "网页残留"
      ],
      "notes": [],
      "review": "source-reviewed",
      "relatedParagraphIds": [
        "ziwei-doushu-quanshu:L0012-L0012"
      ]
    },
    {
      "paragraphId": "ziwei-doushu-quanshu:L0201-L0201",
      "kind": "理论",
      "vernacular": "星垣论以紫微为帝座、辅弼为辅佐，说明主星和协助者共同构成作用体系，并以南北二斗会合解释本术来源。",
      "terms": [
        "紫微辅弼",
        "南北斗",
        "主辅"
      ],
      "notes": [
        "这是传统结构说明，不是现代天文学星体运动公式。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "ziwei-doushu-quanshu:L0203-L0203",
      "kind": "理论",
      "vernacular": "本段用水火相济比喻阴阳协调：一方过盛会损伤另一方，因此两者不能偏废。",
      "terms": [
        "阴阳既济",
        "水火偏盛"
      ],
      "notes": [
        "‘水淘溶’字句不稳，不能从这一比喻推导具体星曜权重。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "ziwei-doushu-quanshu:L0205-L0205",
      "kind": "规则候选",
      "vernacular": "寅卯属于木位，作者以萌芽到木旺解释贪狼、天机得地，并论天相水到寅、巨门水到卯的通达。随后要求土培、水灌，再在三方有文曲、破军等水曜，或有禄存土来配合。",
      "terms": [
        "寅卯木垣",
        "机贪",
        "三方会照",
        "水土配合"
      ],
      "notes": [
        "所有条件有具体宫位和三方关系，不能按多颗木水土星共现宣布有利。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "ziwei-doushu-quanshu:L0207-L0207",
      "kind": "规则候选",
      "vernacular": "这一段从巨门到丑、天梁到未及陀罗入四墓谈土金关系，再加擎羊、天府、天同等帮助，取土生金而使金气通达的解释。",
      "terms": [
        "巨门丑",
        "天梁未",
        "陀罗四墓",
        "金趁土肥"
      ],
      "notes": [
        "本段称‘天同金’，与本书其他天同属性口径需对照；不默改成现行引擎五行，也不整段当已可执行。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "ziwei-doushu-quanshu:L0209-L0209",
      "kind": "理论",
      "vernacular": "巳午火位被用来解释廉贞、文曲等得地：作者说午火能生起已绝之土，光明照彻；再会紫微天府可取魁星拱斗，加天机贪狼又另称变景。",
      "terms": [
        "巳午火垣",
        "廉贞",
        "文曲",
        "魁星拱斗",
        "变景"
      ],
      "notes": [
        "这是依星性与宫位推论的传统解释，不是仅以五行相生就能重建全部庙旺表。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "ziwei-doushu-quanshu:L0211-L0211",
      "kind": "规则候选",
      "vernacular": "申酉属西方金位。武曲在申被说成好生，擎羊在酉偏杀；巨门、禄存、陀罗加助后作用更急，作者还要求逆行及遇善化恶来转圜。",
      "terms": [
        "武曲申",
        "擎羊酉",
        "逆行",
        "化恶"
      ],
      "notes": [
        "逆行指哪一层运限须合上下文，不能把所有命盘统一倒排。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "ziwei-doushu-quanshu:L0213-L0213",
      "kind": "规则候选",
      "vernacular": "亥为文曲、破军的水地，作者用水源清洁比文雅；破军到子则像汹涌大海，还要土来约束水势、武曲金来不断源流，才称合宜。",
      "terms": [
        "文曲破军亥",
        "破军子",
        "武曲金",
        "制与生"
      ],
      "notes": [
        "本句同时要制约与生源，不能只见金生水就忽略水势及土的条件。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "ziwei-doushu-quanshu:L0215-L0215",
      "kind": "理论",
      "vernacular": "其余星曜也应回到身宫、命宫及所处宫垣来推论，本段以此结束星垣论。",
      "terms": [
        "身命",
        "星垣"
      ],
      "notes": [],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "ziwei-doushu-quanshu:L0218-L0218",
      "kind": "重复",
      "vernacular": "斗数准绳标题后的网页编辑标记，与前面残留相同。",
      "terms": [
        "网页残留"
      ],
      "notes": [],
      "review": "source-reviewed",
      "relatedParagraphIds": [
        "ziwei-doushu-quanshu:L0012-L0012"
      ]
    },
    {
      "paragraphId": "ziwei-doushu-quanshu:L0220-L0220",
      "kind": "理论",
      "vernacular": "命宫在生旺处还要看具体星曜是否得宜；身宫遇空亡，也要抓住它如何影响兴衰的关键，不能统一作一种结论。",
      "terms": [
        "命生旺",
        "身空亡",
        "各有所宜"
      ],
      "notes": [],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "ziwei-doushu-quanshu:L0222-L0222",
      "kind": "规则候选",
      "vernacular": "作者区分紫微与天府在所谓南极、南地的作用：紫微在该处不易施展，天府则被说成能够为福。",
      "terms": [
        "紫微南极",
        "天府南地"
      ],
      "notes": [
        "南极、南地的地支范围在本句未说明，不擅自等同某一宫位或现代地理南方。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "ziwei-doushu-quanshu:L0224-L0224",
      "kind": "待核实",
      "vernacular": "此句将天机七杀同宫说成仍有善处，将太阴火铃同位说成不利。它首先提出同宫、同位条件，但是否是同一本命盘层或别层相叠，文字未明。",
      "terms": [
        "天机七杀同宫",
        "太阴火铃",
        "层次待核"
      ],
      "notes": [
        "天机与七杀按常见十四主星固定排布并非通常本命同宫组合；不能把全盘都有这两星当命中，也不能为满足古句改安星。"
      ],
      "review": "source-reviewed"
    }
  ]
}
