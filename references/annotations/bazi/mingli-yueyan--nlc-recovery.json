    {
      "paragraphId": "mingli-yueyan:nlc-recovery:P020:L009-L011",
      "kind": "术语",
      "vernacular": "正官作为主线而兼印，本表称官印格；兼财则称财官格。名称说明参与关系，还没有回答印财力量或官星是否受损。",
      "terms": [
        "正官格",
        "官印格",
        "财官格"
      ],
      "notes": [
        "主格是正官，勿仅因名称相同就与印格用官合并"
      ],
      "review": "source-reviewed",
      "relatedParagraphIds": [
        "mingli-yueyan:nlc-recovery:P021:L010-L012"
      ]
    },
    {
      "paragraphId": "mingli-yueyan:nlc-recovery:P021:L006-L008",
      "kind": "术语",
      "vernacular": "偏官主线兼印，本表称杀印格；兼财称财杀格。这里先命名配置，能否采用仍要查财助杀是否过重、印能否转化等后文条件。",
      "terms": [
        "偏官格",
        "杀印格",
        "财杀格"
      ],
      "notes": [
        "表中列名不是一律主张财杀相见有利"
