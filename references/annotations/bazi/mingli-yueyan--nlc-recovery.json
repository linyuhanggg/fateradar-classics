    },
    {
      "paragraphId": "mingli-yueyan:nlc-recovery:P021:L010-L012",
      "kind": "术语",
      "vernacular": "印格兼官叫官印格，兼杀叫杀印格。同样的组合名称，在这里由印作主线，与官格或杀格为主的观察侧重点不同。",
      "terms": [
        "印格",
        "官印格",
        "杀印格"
      ],
      "notes": [
        "保留主从方向，不只按两颗十神共现匹配"
      ],
      "review": "source-reviewed",
      "relatedParagraphIds": [
