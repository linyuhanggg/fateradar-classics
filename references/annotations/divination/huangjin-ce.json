    {
      "paragraphId": "huangjin-ce:L0020-L0020",
      "kind": "理论",
      "vernacular": "开篇要求把动静、阴阳和变化放在同一套关系中理解，不能见到一个名称就孤立下断。这里是论述方法，不是具体可执行条件。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0022-L0022",
      "kind": "理论",
      "vernacular": "太过应减、不足应补，说明同一种助力并非越多越好。原句未给过与不及的量化门槛，不能自行造分数后称古法。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0024-L0024",
      "kind": "理论",
      "vernacular": "生扶拱合与克害刑冲、长生帝旺与死墓绝空先作一般比喻。后文另讲旺不空、墓难克等例外，不能据这一句统一判所有生吉克凶。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0026-L0026",
      "kind": "理论",
      "vernacular": "日辰和月建是判断各爻的重要参照，但它们生扶的是用神还是忌神会改变作用；帮忌神不能因得月日助就被说成好。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0028-L0028",
      "kind": "理论",
      "vernacular": "岁君动静及身位扶伤是两个观察项。身位在此没有完整起法，不能默认等于世爻，也不把岁君出现全当坏事。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0030-L0030",
      "kind": "理论",
      "vernacular": "世用于己方，应用于他方；本动爻和所化爻分起始与后续，宜相合而忌交争。对象与时间层次要分别保存。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0032-L0032",
      "kind": "理论",
      "vernacular": "应受伤主要联系所问的他方，世受制主要联系自己，不能在未明确所问对象时把两者混断。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0034-L0034",
      "kind": "理论",
      "vernacular": "世应两空取双方不实，内外皆动取事态翻腾。两组条件各独立，不能只见任一爻空或动就称全局如此。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0036-L0036",
      "kind": "理论",
      "vernacular": "世动被比为顾望方向，应动被比为心猿未定，讲双方态度不稳的传统象义，不是实际心理测量。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0038-L0038",
      "kind": "理论",
      "vernacular": "用神有气还必须没有别的损伤才谈可成；仅名义存在而受伤不足以支持。这句话明确要求检查未列出的干扰，不能有用神即满足。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0040-L0040",
      "kind": "理论",
      "vernacular": "受伤要看有没有救，空与合还要看冲破后的变化；并不是所有空逢冲都直接转有效，须结合后文动静衰旺。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0042-L0042",
      "kind": "理论",
      "vernacular": "自空化空与刑克夹杂的合分别提出不利情形，和后面空化空虽空不空存在条件差别，需同篇合读，不能把两句硬合为单一规则。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0044-L0044",
      "kind": "理论",
      "vernacular": "动爻遇合可能被绊，静爻受冲可能暗动。这里提出候选机制，暗动还须结合旺衰条件，不能将所有受冲静爻标活动。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0046-L0046",
      "kind": "理论",
      "vernacular": "入墓可能限制克力，带旺则不能只凭空名当完全无用。要区分形态标记与当下作用，不删除墓空事实。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0048-L0048",
      "kind": "理论",
      "vernacular": "休囚衰弱若得到真正扶助仍可能可用；贪生贪合可使原来的刑冲克害暂不能施。这些作用须有实际对象，不凭字面生合取消全部克。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0050-L0050",
      "kind": "理论",
      "vernacular": "生克合要分衰旺，刑冲要分动静。它要求条件化解释，不能把静态关系表直接当实际作用结论。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0052-L0052",
      "kind": "理论",
      "vernacular": "多个相同支、缺少构成关系的支，会影响并冲刑合能否成立。原句用多与少概说，具体构成须另核，不自行补不存在的支。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0054-L0054",
      "kind": "理论",
      "vernacular": "爻得令星可有支持，伏神处空又有不遂之虑。令星在本句未详起法，不机械视为任意神煞，伏的上下位置也须明确。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0056-L0056",
      "kind": "理论",
      "vernacular": "伏神须能被引出，飞神也须能够移开，否则仅有伏神名义不够。提拔与推开分别指两种作用对象。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0058-L0058",
      "kind": "理论",
      "vernacular": "空飞之下的伏神较易被引出；受制的弱用神不易维持。不是一见飞空就保证伏神有效，还需其自身旺衰和其他条件。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0060-L0060",
      "kind": "理论",
      "vernacular": "日伤爻与爻伤日不能对称处理；墓要逢冲才有发机，身鬼须解除才谈安。后两句都是条件，不把墓或鬼直接当最终事件。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0062-L0062",
      "kind": "理论",
      "vernacular": "德与忌分别联系支持和阻碍，但必须实际入卦临身且适用于所问；德忌在此未完整定义，不能任意用神煞名称替换。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0064-L0064",
      "kind": "理论",
      "vernacular": "遇凶有避的办法、忌煞受敌制能减害，强调救制与行动条件，而不是所有凶名一律无解。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0066-L0066",
      "kind": "理论",
      "vernacular": "用神休囚时更须防刑冲克害，动用神又须检查变后死墓绝空，不能只按发动认为有力。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0068-L0068",
      "kind": "理论",
      "vernacular": "用化用和空化空存在真假可用的分辨，句子有意设问式对举，不能脱离前后文自动判成立或不成立。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0070-L0070",
      "kind": "理论",
      "vernacular": "养、墓、化病、化胎分别取疑、暗、损、牵连的旧象。墓句“暗味”字形可疑，保留不擅改；这里不把长生阶段当现实生理状态。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0072-L0072",
      "kind": "理论",
      "vernacular": "凶作用得到长生可能更盛，吉作用走向沐浴可能衰败，所以长生不能总作吉、沐浴也须看对象。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0074-L0074",
      "kind": "理论",
      "vernacular": "变爻回头克原爻须警惕，支持转向他方也可能不利于己。方向和对象必须明确，不能只存一对无向生克关系。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0076-L0076",
      "kind": "理论",
      "vernacular": "弱忌可能因日并而起，重叠用神又可能因墓收束而有利；并与墓不是固定一好一坏，须看受作用者。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0078-L0078",
      "kind": "理论",
      "vernacular": "间爻发动可成双方阻隔，世空可取自身退悔。前者是特定位置而非任何中间字，后者为传统象义，不断言真实心理。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0080-L0080",
      "kind": "理论",
      "vernacular": "看爻动要分老阴老阳，动变同五行还要辨进神退神，不能把比和一律当无变化。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0082-L0082",
      "kind": "理论",
      "vernacular": "忌煞生世未必吉，用神克世也未必凶；单一生克方向不足以下结论，须继续读合中刑害等条件。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0084-L0084",
      "kind": "理论",
      "vernacular": "生中可带刑害、合处可有克伤，这些关系可能并存，不能让一项合自动消掉其余风险条件。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0086-L0086",
      "kind": "理论",
      "vernacular": "刑害临用、死绝持身分别指受作用对象；动逢冲可能散，绝逢生可能成，仍与强弱和实际救应合看，不把静动冲混为一例。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0088-L0101",
      "kind": "理论",
      "vernacular": "赋文说合住须冲破、休囚须生旺才能成事。紧接L89–101为后附应期注释，细分用世旺弱、静动、空合、入墓等，列出出旬、冲墓或当下等办法；这层附注作者未明，不能全部归为赋文原意，也未证明这些日期法可预测现实。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [
        "L88为赋文，L89–101为后附注释；附注作者未明，尤其等号等现代表达不得当作原赋同层引文。"
      ],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0103-L0103",
      "kind": "理论",
      "vernacular": "动而克世取急，静而生身取缓，动静与生克两个条件必须同时看，不是所有动爻都对应即时发生。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0105-L0105",
      "kind": "理论",
      "vernacular": "父母缺失与福德伏藏分别取事项缺头绪、未称情的旧象；须先明确当前事项是否以该六亲为用，不能对所有占类统一套。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0107-L0107",
      "kind": "理论",
      "vernacular": "官鬼虽凶，伏而无气可能无害；子孙虽福，多也可能无功。这明确限制了按六亲名称判断吉凶。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0109-L0109",
      "kind": "理论",
      "vernacular": "父母取体统、官鬼取祸的概论属于本篇类象，其他官职占又可能以官为用，不能跨事项直接套用。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0111-L0111",
      "kind": "理论",
      "vernacular": "财以禄、子孙以福德作一般类比，不等同具体问题里一律喜财喜子。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0113-L0113",
      "kind": "理论",
      "vernacular": "兄弟发动可阻谋，卦身重叠可关联两件事。卦身起法未在本句给全，不能把六爻重复支当卦身重叠。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0115-L0115",
      "kind": "理论",
      "vernacular": "白虎配到有效吉神不必凶，青龙配凶曜也不能掩凶，六神名称不应凌驾实际用忌和生克。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0117-L0117",
      "kind": "理论",
      "vernacular": "玄武盗事还要求官爻，朱雀口舌还须兄弟，是六神与六亲的联合条件，不是全盘见玄雀就断盗讼。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0119-L0119",
      "kind": "理论",
      "vernacular": "天喜、往亡仍须和吉凶爻神一起看：病见天喜不抹其他凶，出行见往亡也不一律失败。属传统占法，不作医学或旅行风险保证。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0121-L0121",
      "kind": "理论",
      "vernacular": "全篇以生克制化贯穿神煞，不能靠罗列神煞数量替代作用关系。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0123-L0123",
      "kind": "理论",
      "vernacular": "结尾讲占者与求问者对前后经验的理解，是方法劝勉，不是准确率证据。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0125-L0125",
      "kind": "理论",
      "vernacular": "主张诚心可筮、不以子日禁占，是对择日起卦禁忌的态度；不由此证明起卦有现实预测效力。",
      "terms": [
        "1、總斷千金賦"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0128-L0128",
      "kind": "理论",
      "vernacular": "天时章开篇说明以卦推阴晴的传统用途，未给实际气象观测或验证。",
      "terms": [
        "2、天時"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0130-L0130",
      "kind": "理论",
      "vernacular": "天时先以父母雨、妻财晴为核心，不仅按水火五行字面判雨晴。发动和兴隆是条件，不能财父静现即同断。",
      "terms": [
        "2、天時"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0132-L0132",
      "kind": "理论",
      "vernacular": "应取天空、世取地，和其他事项世己应彼的用法不同。应空使雨晴难拟，世受克取天变，都需具体天时问法。",
      "terms": [
        "2、天時"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0134-L0134",
      "kind": "理论",
      "vernacular": "日辰取一日阴晴，子孙管日月晴明；句中九天不当自动固定九日预测窗口。",
      "terms": [
        "2、天時"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0136-L0136",
      "kind": "理论",
      "vernacular": "兄弟看风云、官鬼看雷电，是此章的六亲类象，不能改成所有占类兄弟必风官必雷。",
      "terms": [
        "2、天時"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0138-L0138",
      "kind": "理论",
      "vernacular": "天气取象还要求季节与五行配合，不允许仅六亲单项完成天气判断。",
      "terms": [
        "2、天時"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0140-L0140",
      "kind": "理论",
      "vernacular": "晴遇官可取烟雾，雨遇子孙可取电虹，必须有先行晴雨语境，同一官子不独断。",
      "terms": [
        "2、天時"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0142-L0142",
      "kind": "理论",
      "vernacular": "子孙在应与土鬼持世分别取晴空、沙尘，位置和六亲五行联合，不是任何子孙或土爻都如此。",
      "terms": [
        "2、天時"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0144-L0144",
      "kind": "理论",
      "vernacular": "三合财局不利求雨，连父又牵涉求晴；句中“五乡连父”表述未详，不补成未核的固定五爻规则。",
      "terms": [
        "2、天時"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0146-L0146",
      "kind": "理论",
      "vernacular": "财化鬼和父化兄分别显示阴晴、风雨变动，原爻与变爻的方向不能交换。",
      "terms": [
        "2、天時"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0148-L0148",
      "kind": "理论",
      "vernacular": "父化子取雨后虹，兄连福取云中日月现，强调天气先后变化而非同时发生。",
      "terms": [
        "2、天時"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0150-L0150",
      "kind": "理论",
      "vernacular": "父母得月建可能雨久，兄弟得长生可能风久；这里没有精确日数边界，不把连旬累日造为固定时长。",
      "terms": [
        "2、天時"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0152-L0152",
      "kind": "理论",
      "vernacular": "财父无助取维持旧天气，子孙带刑取日月食旧象；后者缺少现代天文输入，不作为日食月食计算。",
      "terms": [
        "2、天時"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0154-L0154",
      "kind": "理论",
      "vernacular": "雨与财冲、晴与父墓分不同所问，不能把父墓单独定为任何天气都吉。",
      "terms": [
        "2、天時"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0156-L0156",
      "kind": "理论",
      "vernacular": "子伏财飞取晴中仍郁，父衰官旺取行客雨阻，飞伏及旺衰是联合条件，不只看财官名称。",
      "terms": [
        "2、天時"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0158-L0158",
      "kind": "理论",
      "vernacular": "福合应且木动取游丝，鬼冲身又金会取阴雾，多个位置和五行条件须保留，未明的“会”不自补支数。",
      "terms": [
        "2、天時"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0160-L0160",
      "kind": "理论",
      "vernacular": "暗冲可使空者仍有希望，合住可使动者暂不能作用；暗冲有效仍须符合总断的动静旺衰限制。",
      "terms": [
        "2、天時"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0162-L0162",
      "kind": "理论",
      "vernacular": "父被合由鬼冲开可取雷雨，财被合由兄克破可取风晴；必须先有合住和后来的解除关系，不能有官兄便算救应。",
      "terms": [
        "2、天時"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0164-L0164",
      "kind": "理论",
      "vernacular": "坎巽互交、阴阳各半是天气取象，不是现代降雪降雨的充分条件，卦象如何相交还需另核。",
      "terms": [
        "2、天時"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0166-L0166",
      "kind": "理论",
      "vernacular": "兄木兴而系巽取大风，财动属乾阳取旱，六亲、五行、卦位与动必须联合。",
      "terms": [
        "2、天時"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0168-L0168",
      "kind": "理论",
      "vernacular": "蛇兴震、鬼发离分别论雷电，与六神或宫位单独出现不同；六龙五雷是修辞，不造六次或五次事件计数。",
      "terms": [
        "2、天時"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0170-L0170",
      "kind": "理论",
      "vernacular": "土父取云雨、木扶身取暖和，只是组合取象，还须与本章父财动静及季节同看。",
      "terms": [
        "2、天時"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0172-L0172",
      "kind": "理论",
      "vernacular": "财父同动取晴雨相间，财官皆动取烟雾多，不能只选其中一个喜用忽略同时动者。",
      "terms": [
        "2、天時"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0174-L0174",
      "kind": "理论",
      "vernacular": "同人卦身与世子孙在阴晴语境取日晕、雷隐，身的具体所指未详不默认世；总雨旧词不改字凑结论。",
      "terms": [
        "2、天時"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0176-L0176",
      "kind": "理论",
      "vernacular": "父空财伏时改察辅爻，克日取期也要求明占法；原句未列完整辅爻和日期算法，保留待进一步展开。",
      "terms": [
        "2、天時"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0178-L0178",
      "kind": "理论",
      "vernacular": "阴阳用于大类晴雨，旺衰用于程度，是层次说明，不是已标注天气强度数据。",
      "terms": [
        "2、天時"
      ],
      "notes": [],
      "review": "source-reviewed",
      "verified": false
    },
    {
      "paragraphId": "huangjin-ce:L0180-L0180",
      "kind": "理论",
      "vernacular": "末句劝熟悉方法与变化，为篇章收束，不当作独立气象规则。",
      "terms": [
        "2、天時"
      ],
