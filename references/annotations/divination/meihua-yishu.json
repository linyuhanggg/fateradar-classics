      "terms": [
        "牡丹占",
        "天风姤",
        "五爻动",
        "鼎",
        "重乾"
      ],
      "notes": [
        "只核起卦数字、卦形及动爻，不把原书叙述的应验当作算法准确率。"
      ],
      "review": "source-reviewed",
      "cases": [
        {
          "kind": "source_case",
          "inputBasis": "meihua-numbers",
          "name": "牡丹占",
