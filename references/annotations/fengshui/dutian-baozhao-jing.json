{
  "bookSlug": "dutian-baozhao-jing",
  "entries": [
    {
      "paragraphId": "dutian-baozhao-jing:L0003-L0008",
      "kind": "评注或元数据",
      "vernacular": "本段是电子底本说明，不是经文。底本取自NCC单页HTML，系统标为风水，网页题署含《都天宝照经 地理辨正疏》及蒋大鸿字样；授权未明，整理者声明须与《地理辨正》刊本校勘。规范化只去掉网页导航与空白，保留原页繁体和标点，不改句读。",
      "terms": [
        "都天宝照经",
        "地理辨正疏",
        "蒋大鸿"
      ],
      "notes": [
        "蒋大鸿只出现在网页题署，源文件未证明经文作者，不补撰人。",
        "授权未明，仅作临时全文底本。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0012-L0012",
      "kind": "序跋目录",
      "vernacular": "开篇借杨公之名讲传授与安命，称诀窍在行家相传，不在说得多。这里是全篇的开场表述，没有给出辨龙立穴的具体条件。",
      "terms": [
        "杨公"
      ],
      "notes": [
        "经中称杨公；仅凭本段不能核定实际作者，也不能确定是托名。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0014-L0014",
      "kind": "规则候选",
      "vernacular": "贫贱之家安坟而能转富贵，条件全在龙穴要真。山中之龙并不出山，只是挂在大山之间，尚未走到平地。",
      "terms": [
        "龙穴",
        "龙"
      ],
      "notes": [],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0016-L0016",
      "kind": "规则候选",
      "vernacular": "若砂体弯曲、星辰形体端正，并能收住阳神，作者认为一葬就会兴旺，父辈发达、子辈承荣。此为传统吉断，不是实测。",
      "terms": [
        "砂",
        "星辰",
        "阳神"
      ],
      "notes": [
        "星辰指山体星峰形象，不是天文行星。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0018-L0018",
      "kind": "术语",
      "vernacular": "本段把远来山脉从高山转到平洋、逐渐显出可辨形体称作好龙，并以“离祖离宗”形容离开祖山后的走势。“脱劫”在本段没有展开具体识别步骤。",
      "terms": [
        "脱劫",
        "平洋",
        "真龙骨"
      ],
      "notes": [
        "不把未详解的脱劫直接固定为某一种过峡形状。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0020-L0020",
      "kind": "规则候选",
      "vernacular": "龙向前走要一节节生出儿孙山，文脉与武脉从中分开。一直见到大溪才停住，两侧诸山都不走散。",
      "terms": [
        "儿孙",
        "文武脉",
        "大溪"
      ],
      "notes": [
        "儿孙指前方分枝山，不是人口。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0022-L0022",
      "kind": "待核实",
      "vernacular": "这里要求周围山形回顾、围护周全，又把水口有石阻护与出豪雄联系起来。“向月前”文义不明，不能据这几个字画成月形朝案。",
      "terms": [
        "回头",
        "城郭",
        "水口"
      ],
      "notes": [
        "向月前保留原字，需对可靠刊本；没有据推测改为另一句。"
      ],
      "review": "source-reviewed",
      "relatedParagraphIds": [
        "dutian-baozhao-jing:L0020-L0020",
        "dutian-baozhao-jing:L0024-L0024"
      ]
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0024-L0024",
      "kind": "规则候选",
      "vernacular": "承接远来龙脱劫的条件，作者给出持续发福的传统说法；又要求穴前“阳神三摺朝”，并联系官贵。三摺如何判定、阳神在此具体指什么，当前短句不足以落实成几何规则。",
      "terms": [
        "脱劫",
        "阳神",
        "三摺朝"
      ],
      "notes": [],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0026-L0026",
      "kind": "规则候选",
      "vernacular": "本段承接前文远龙、脱劫及朝穴条件，宣称各房都可得益，并说津湖溪涧可依此观察。不能抽去上文，理解成凡有湖溪就会富贵；三男五子是房分表述。",
      "terms": [
        "津",
        "湖",
        "溪",
        "涧"
      ],
      "notes": [],
      "review": "source-reviewed",
      "relatedParagraphIds": [
        "dutian-baozhao-jing:L0024-L0024"
      ]
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0028-L0028",
      "kind": "规则候选",
      "vernacular": "大水大河一齐汇到之处，千里来龙才停住。水口有罗星锁门，作者比作大将屯军。",
      "terms": [
        "罗星",
        "水口"
      ],
      "notes": [],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0030-L0030",
      "kind": "规则候选",
      "vernacular": "落头必须有一种星形，不是火、土，就是金，不提水、木。正脉落到平地走三五里，见到水才能止住。",
      "terms": [
        "落头",
        "星形",
        "火",
        "土",
        "金"
      ],
      "notes": [
        "火土金是山体五星形象，不是行星或八字五行运算。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0032-L0032",
      "kind": "规则候选",
      "vernacular": "两水相交时，本段提出“不用砂”，但紧接要求石多，并有硤石、高山收锁包裹。它强调此种水口的收束条件，不能简化成任何两水交会都无需围护。",
      "terms": [
        "二水相交",
        "硤石"
      ],
      "notes": [
        "硤石按原字保留，不据单句补图或固定形状。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0034-L0034",
      "kind": "理论",
      "vernacular": "作者把前述水会、收锁的形势称为军州大地，反问城邑何曾都靠后方山脉支撑。这里是在反对把“后必有撑龙”一概套用；“住空”的具体含义仍需连同中篇各句看。",
      "terms": [
        "军州",
        "空",
        "后头龙"
      ],
      "notes": [],
      "review": "source-reviewed",
      "relatedParagraphIds": [
        "dutian-baozhao-jing:L0060-L0060",
        "dutian-baozhao-jing:L0064-L0064",
        "dutian-baozhao-jing:L0066-L0066"
      ]
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0036-L0036",
      "kind": "操作步骤",
      "vernacular": "取穴只向水神来朝的地方，不要因为后面没有主山就放弃。立穴在动与静的中间求，还须看龙是否真到了头。",
      "terms": [
        "水神",
        "动静",
        "到头"
      ],
      "notes": [],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0038-L0038",
      "kind": "待核实",
      "vernacular": "这段从杨公妙诀转到黄公及“掌上起星辰、类聚装成”的说法。后文继续讨论辨脉与罗经，全文又批评只靠卦例，不能仅凭本句认定杨公因黄公拙笨而创造了掌诀。",
      "terms": [
        "杨公",
        "黄公",
        "掌上起星辰"
      ],
      "notes": [
        "黄公所指及这几句的褒贬、主语衔接未由当前底本解释，保留文义疑点。"
      ],
      "review": "source-reviewed",
      "relatedParagraphIds": [
        "dutian-baozhao-jing:L0104-L0104",
        "dutian-baozhao-jing:L0106-L0106",
        "dutian-baozhao-jing:L0114-L0114"
      ]
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0040-L0040",
      "kind": "术语",
      "vernacular": "大山叫做破军体。五星聚在一处时，脉路难分。只看出身那一路脉，到头要分辨水、土、金三种形体。",
      "terms": [
        "破军体",
        "五星",
        "出身"
      ],
      "notes": [
        "破军、五星是山体名称，不是七政。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0042-L0042",
      "kind": "操作步骤",
      "vernacular": "从分水的脉脊处下手，用罗经照出脉路。一节节同向走过真峡，作者认为前面必有好处。",
      "terms": [
        "分水",
        "脉脊",
        "罗经",
        "过峡"
      ],
      "notes": [],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0044-L0044",
      "kind": "规则候选",
      "vernacular": "子字出脉就沿子字去寻，不要错到丑与壬。若已是阳差、阴错，作者劝人不必再费心寻找。",
      "terms": [
        "子",
        "丑",
        "壬",
        "阳差",
        "阴错"
      ],
      "notes": [
        "子丑壬是罗盘字位，不是八字日辰。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0046-L0046",
      "kind": "术语",
      "vernacular": "本段把子癸午丁称为天元宫，并说卯乙酉辛一路同看；接着联系山水同到与乾坤艮巽。末句“半穴”未释，不能改写成可执行的取穴位置或比例。",
      "terms": [
        "天元宫",
        "子癸午丁",
        "卯乙酉辛",
        "乾坤艮巽"
      ],
      "notes": [
        "此处是本段的字位分组，不直接套用其他流派的三元龙表；半穴待校。"
      ],
      "review": "source-reviewed",
      "relatedParagraphIds": [
        "dutian-baozhao-jing:L0076-L0076",
        "dutian-baozhao-jing:L0078-L0078"
      ]
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0048-L0048",
      "kind": "术语",
      "vernacular": "取得辅星才能凑成五吉，山中有此才算真龙。辰戌丑未是地元龙；乾坤艮巽称为夫妇宗。",
      "terms": [
        "辅星",
        "五吉",
        "地元龙",
        "夫妇宗"
      ],
      "notes": [],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0050-L0050",
      "kind": "规则候选",
      "vernacular": "原文把甲庚壬丙列为正向，又谈贪狼护龙、寅申巳亥人元以及乙辛丁癸水来配合。这里同时列出山向与水的字位关系，但尚未给出完整起星与取向步骤。",
      "terms": [
        "甲庚壬丙",
        "贪狼",
        "人元",
        "乙辛丁癸"
      ],
      "notes": [
        "贪狼按本经地理九星名目理解，不转为紫微星曜落宫或现代天文位置。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0052-L0052",
      "kind": "规则候选",
      "vernacular": "再取贪狼以成五吉。寅与坤、申与艮称御门开。巳丙宜朝天门；亥壬之向要得巽风吹到。",
      "terms": [
        "五吉",
        "御门",
        "天门",
        "巽风"
      ],
      "notes": [
        "天门、巽风是罗盘方位用语，不是气象实测。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0054-L0054",
      "kind": "规则候选",
      "vernacular": "作者说贪狼相关的坐向不会立即显出所称福应，须在立宅安坟后“过两纪”才见贵子。这是经内的时间断语，当前没有具体个案可核，不用于给用户承诺生育或应期。",
      "terms": [
        "贪狼",
        "两纪"
      ],
      "notes": [
        "原文没有解释纪的折算；白话不额外填入年数。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0056-L0056",
      "kind": "理论",
      "vernacular": "立宅安坟要与来龙相合，不必去对准奇峰。用主客礼数作喻：客在西、主在东，主有礼则客受尊重。",
      "terms": [
        "合龙",
        "主",
        "客"
      ],
      "notes": [
        "主客东西是比喻，未给辨方步骤。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0060-L0060",
      "kind": "理论",
      "vernacular": "中篇重申天下军州都住空，不必用后面来龙撑住。时人不知此诀，只抱怨后头少撑龙。作者把时人的撑龙说反过来否定。",
      "terms": [
        "空",
        "后来龙",
        "玄机诀"
      ],
      "notes": [
        "与上篇何曾撑着后头龙同旨，用字改为何须、后来。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0062-L0062",
      "kind": "理论",
      "vernacular": "军州所住的空龙，与平洋墓宅同一类。州县人家住空龙，作者说能容得下千军万马。",
      "terms": [
        "空龙",
        "平洋"
      ],
      "notes": [],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0064-L0064",
      "kind": "待核实",
      "vernacular": "本段说见者仍有疑虑，写下“龙不空时气不空”，又让人观察州县的空龙踪迹。它与前后倡言后空的段落并列，但这句究竟是反问、省略转语还是字误，当前底本不能确定。",
      "terms": [
        "空龙",
        "气"
      ],
      "notes": [
        "草稿把龙不空句认作他人的观点，原文没有明确引语标志，已撤回该肯定解释。"
      ],
      "review": "source-reviewed",
      "relatedParagraphIds": [
        "dutian-baozhao-jing:L0060-L0060",
        "dutian-baozhao-jing:L0062-L0062",
        "dutian-baozhao-jing:L0066-L0066"
      ]
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0066-L0066",
      "kind": "待核实",
      "vernacular": "先说不要嫌远来没有后龙；紧接着又说龙若空就不是活龙，与上段推崇州县空龙的口气冲突，原文如此。下文则称两水界龙能连到生窟，穴得水就不必怕风。",
      "terms": [
        "后龙",
        "空",
        "活龙",
        "两水界龙"
      ],
      "notes": [
        "龙若空时非活龙与前后空龙说冲突，不按常识改通。"
      ],
      "review": "source-reviewed",
      "relatedParagraphIds": [
        "dutian-baozhao-jing:L0064-L0064",
        "dutian-baozhao-jing:L0072-L0072"
      ]
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0068-L0068",
      "kind": "规则候选",
      "vernacular": "作者举古来卿相地：平洋一穴胜过千峰。子午卯酉四山龙，坐对要朝乾坤艮巽宫。",
      "terms": [
        "平洋",
        "子午卯酉",
        "乾坤艮巽"
      ],
      "notes": [],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0070-L0070",
      "kind": "理论",
      "vernacular": "不要按八卦阴阳去取。阴阳差错会败个不停。所谓一百二十家都渺茫无诀，作者把本诀称作玄机大祖宗。",
      "terms": [
        "八卦",
        "阴阳差错"
      ],
      "notes": [
        "百二十家是贬称，未列名单。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0072-L0072",
      "kind": "规则候选",
      "vernacular": "来龙必须望向龙穴。后面若空，作者反说必有功。帝座、帝车、帝位、帝宫、帝殿这些格局，后面都应当空。",
      "terms": [
        "帝座",
        "帝车",
        "帝位",
        "帝宫",
        "帝殿"
      ],
      "notes": [
        "鬚字按文义同须，底本未改。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0074-L0074",
      "kind": "序跋目录",
      "vernacular": "作者称此格局万代侯王都禁断不传，如今自己在江东隐约说出。阴阳家若能遇上，连蚯蚓也会变成龙。此为传授口吻，不是操作细则。",
      "terms": [
        "江东"
      ],
      "notes": [
        "予今隐出在江东是文本自述，不补作者姓名。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0076-L0076",
      "kind": "规则候选",
      "vernacular": "子午卯酉四山龙，地支兼天干出脉最称豪雄。乙辛丁癸若是单行一脉，则半吉半凶。",
      "terms": [
        "支兼干",
        "乙辛丁癸",
        "单行脉"
      ],
      "notes": [],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0078-L0078",
      "kind": "规则候选",
      "vernacular": "坐向落在乾坤艮巽，再兼辅星才成五吉龙。辰戌丑未四山坡上，甲庚丙壬方向葬坟的多。",
      "terms": [
        "五吉龙",
        "辰戌丑未",
        "甲庚丙壬"
      ],
      "notes": [],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0080-L0080",
      "kind": "规则候选",
      "vernacular": "若依上述道理没有差错，作者许以清贵声名。为官自有起身之路，儿孙能从白屋登科。此为传统贵贱说。",
      "terms": [
        "清贵",
        "白屋",
        "登科"
      ],
      "notes": [],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0082-L0082",
      "kind": "理论",
      "vernacular": "作者批评时师只唱八卦口诀，并把失败与用卦差错相连，随后反问是否能仅凭卦例说明出官。原“败絻”字样不顺，白话只保留可确定的批评方向，不猜补为另一个字。",
