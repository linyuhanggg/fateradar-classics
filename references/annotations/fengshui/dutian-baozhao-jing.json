    {
      "paragraphId": "dutian-baozhao-jing:L0090-L0090",
      "kind": "规则候选",
      "vernacular": "寅申巳亥像骑在龙上走；乙辛丁癸之水交相流。山与水都具备时，作者断白屋科名发个不停。",
      "terms": [
