    {
      "paragraphId": "dutian-baozhao-jing:L0094-L0094",
      "kind": "案例",
      "vernacular": "这一段先以州县官衙谈清显格局，再提范蠡、萧何、韩信之祖，并把乙辛丁癸与财足联系。它是借人物名声说明的传统断语，没有地点、坐向和水路的完整资料，不能作为可复算的真实案例。",
      "terms": [
        "官衙",
        "乙辛丁癸"
      ],
      "notes": [
        "无法从本段确认所述祖地、人物关联或应验经过。"
      ],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0096-L0096",
      "kind": "规则候选",
      "vernacular": "亥壬山峰高耸为兴祖格，巳丙旺相与之同类。寅申巳亥归入五吉，乙辛丁癸四位可通。旺相指本经方位气势，不是八字月令。",
      "terms": [
        "兴祖格",
        "旺相",
        "五吉"
      ],
      "notes": [],
      "review": "source-reviewed"
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0098-L0098",
      "kind": "待核实",
      "vernacular": "前半用紫绯、三牲五鼎和受封描述作者许诺的显贵；后半要求龙回朝祖、玄字水配合，再联系科名。“昼绵”不顺，不能硬译成白天绵延，也没有据猜测改成昼锦。",
      "terms": [
        "玄字水",
        "朝祖"
