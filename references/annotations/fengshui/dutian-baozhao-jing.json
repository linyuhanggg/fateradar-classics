      ],
      "review": "source-reviewed",
      "relatedParagraphIds": [
        "dutian-baozhao-jing:L0174-L0174"
      ]
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0174-L0174",
      "kind": "规则候选",
      "vernacular": "破、禄、廉、文是凶恶龙，世人坟宅不要碰上。若误拿来做阴阳宅，纵有奇峰，作者仍断到底凶。",
      "terms": [
        "破军",
        "禄存",
        "廉贞",
        "文曲"
      ],
      "notes": [],
      "review": "source-reviewed",
      "relatedParagraphIds": [
        "dutian-baozhao-jing:L0172-L0172",
        "dutian-baozhao-jing:L0178-L0178"
      ]
    },
    {
      "paragraphId": "dutian-baozhao-jing:L0176-L0176",
      "kind": "规则候选",
      "vernacular": "本山来龙又立本向，本段称为返吟伏吟，并连缀多项传统凶断。此处没有把返吟、伏吟各自的角度条件分开，不能据名字补出完整坐向判表，更不能移作八字岁运规则。",
